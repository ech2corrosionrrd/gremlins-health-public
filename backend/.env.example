# ==========================================================================
#  Gremlins Health - backend environment
#  Copy to .env and fill in. NEVER commit the real .env.
# ==========================================================================

ENVIRONMENT="development"          # development | staging | production

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""

DATABASE_URL="sqlite+aiosqlite:///./gremlins_health.db"
# Production example:
# DATABASE_URL="postgresql+asyncpg://user:pass@timescaledb:5432/gremlins_health"

REDIS_URL="redis://localhost:6379/0"

SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"
PROGRAM_ID="A9oXQuqhwkycQKPRAHTrqBYZ8v985PagPmcQvEWtSmEX"

# From @BotFather. Leave empty to disable Telegram login entirely.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBAPP_URL="http://localhost:5173"

# Comma-separated. Must NOT contain "*".
BACKEND_CORS_ORIGINS="http://localhost:5173,https://web.telegram.org"

# Set to 1 when running behind a single nginx reverse proxy.
TRUSTED_PROXY_COUNT=0
