# ==========================================================================
#  docker-compose environment. Copy to .env and fill in. Never commit .env.
# ==========================================================================

ENVIRONMENT=production

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

POSTGRES_USER=gremlins
POSTGRES_PASSWORD=
POSTGRES_DB=gremlins_health

# From @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=https://your-domain.example

# Comma-separated, no "*". Same-origin deploys can leave this as the domain.
BACKEND_CORS_ORIGINS=https://your-domain.example

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
